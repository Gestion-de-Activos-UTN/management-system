{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "network": {
      "type": "string"
    },
    "scan_start": {
      "type": "string"
    },
    "scan_end": {
      "type": "string"
    },
    "hosts_up": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "ip": {
            "type": "string"
          },
          "mac": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "os": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "accuracy": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "cpe": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "osfamily": {
                    "default": "",
                    "type": "string"
                  },
                  "osgen": {
                    "default": "",
                    "type": "string"
                  },
                  "vendor": {
                    "default": "",
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "accuracy",
                  "cpe",
                  "osfamily",
                  "osgen",
                  "vendor"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "protocol": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "product": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "extra_info": {
                  "type": "string"
                },
                "cpe": {
                  "type": "string"
                },
                "reason": {
                  "default": "",
                  "type": "string"
                },
                "detection_method": {
                  "default": "table",
                  "type": "string"
                },
                "confidence": {
                  "default": 0,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                "tunnel": {
                  "default": "",
                  "type": "string"
                },
                "scripts": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "port",
                "protocol",
                "state",
                "name",
                "product",
                "version",
                "extra_info",
                "cpe",
                "reason",
                "detection_method",
                "confidence",
                "tunnel",
                "scripts"
              ],
              "additionalProperties": false
            }
          },
          "scan_time": {
            "type": "string"
          },
          "os_candidates": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "accuracy": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "cpe": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "osfamily": {
                  "default": "",
                  "type": "string"
                },
                "osgen": {
                  "default": "",
                  "type": "string"
                },
                "vendor": {
                  "default": "",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "accuracy",
                "cpe",
                "osfamily",
                "osgen",
                "vendor"
              ],
              "additionalProperties": false
            }
          },
          "state_reason": {
            "default": "",
            "type": "string"
          },
          "host_scripts": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "asset_id",
          "agent_id",
          "ip",
          "mac",
          "vendor",
          "hostname",
          "os",
          "services",
          "scan_time",
          "os_candidates",
          "state_reason",
          "host_scripts"
        ],
        "additionalProperties": {}
      }
    },
    "scan_mode": {
      "default": "full",
      "type": "string",
      "enum": [
        "full",
        "degraded"
      ]
    },
    "scan_mode_reason": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "gateway_ip": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "gateway_mac": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "report_id",
    "agent_id",
    "network",
    "scan_start",
    "scan_end",
    "hosts_up",
    "assets",
    "scan_mode",
    "scan_mode_reason",
    "gateway_ip",
    "gateway_mac"
  ],
  "additionalProperties": {}
}
