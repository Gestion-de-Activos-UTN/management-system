{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "ip": {
      "type": "string",
      "format": "ipv4",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
    },
    "mac": {
      "anyOf": [
        {
          "type": "string",
          "const": ""
        },
        {
          "type": "string",
          "pattern": "^(?:[0-9A-F]{2}:){5}[0-9A-F]{2}$"
        }
      ]
    },
    "vendor": {
      "type": "string",
      "maxLength": 240
    },
    "hostname": {
      "type": "string",
      "maxLength": 253
    },
    "os": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 240
            },
            "accuracy": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "cpe": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "osfamily": {
              "type": "string",
              "maxLength": 120
            },
            "osgen": {
              "type": "string",
              "maxLength": 120
            },
            "vendor": {
              "type": "string",
              "maxLength": 120
            },
            "device_type": {
              "type": "string",
              "maxLength": 120
            }
          },
          "required": [
            "name",
            "accuracy",
            "cpe",
            "osfamily",
            "osgen",
            "vendor",
            "device_type"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "services": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "protocol": {
            "type": "string",
            "enum": [
              "tcp",
              "udp",
              "sctp",
              "ip"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "filtered",
              "unfiltered",
              "open|filtered",
              "closed|filtered",
              "unknown"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "product": {
            "type": "string",
            "maxLength": 240
          },
          "version": {
            "type": "string",
            "maxLength": 120
          },
          "extra_info": {
            "type": "string",
            "maxLength": 500
          },
          "cpe": {
            "type": "string",
            "maxLength": 500
          },
          "reason": {
            "type": "string",
            "maxLength": 120
          },
          "detection_method": {
            "type": "string",
            "enum": [
              "probed",
              "table",
              "unknown"
            ]
          },
          "confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "tunnel": {
            "type": "string",
            "maxLength": 40
          },
          "scripts": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 120
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 4000
            }
          }
        },
        "required": [
          "port",
          "protocol",
          "state",
          "name",
          "product",
          "version",
          "extra_info",
          "cpe",
          "reason",
          "detection_method",
          "confidence",
          "tunnel",
          "scripts"
        ],
        "additionalProperties": false
      }
    },
    "scan_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "os_candidates": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 240
          },
          "accuracy": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "cpe": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "osfamily": {
            "type": "string",
            "maxLength": 120
          },
          "osgen": {
            "type": "string",
            "maxLength": 120
          },
          "vendor": {
            "type": "string",
            "maxLength": 120
          },
          "device_type": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "name",
          "accuracy",
          "cpe",
          "osfamily",
          "osgen",
          "vendor",
          "device_type"
        ],
        "additionalProperties": false
      }
    },
    "state_reason": {
      "type": "string",
      "maxLength": 120
    },
    "host_scripts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 120
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "names": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "source": {
            "type": "string",
            "enum": [
              "nmap",
              "ptr",
              "mdns",
              "netbios",
              "ssdp"
            ]
          }
        },
        "required": [
          "value",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "mac_metadata": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "globally_administered",
            "locally_administered",
            "multicast",
            "broadcast",
            "invalid",
            "unknown"
          ]
        },
        "vendor_resolution": {
          "type": "string",
          "enum": [
            "resolved",
            "not_found",
            "not_attempted",
            "unknown"
          ]
        }
      },
      "required": [
        "kind",
        "vendor_resolution"
      ],
      "additionalProperties": false
    },
    "asset_coverage": {
      "type": "object",
      "properties": {
        "port_scan": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "not_attempted",
            "unknown"
          ]
        },
        "service_detection": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "not_attempted",
            "unknown"
          ]
        },
        "os_detection": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "not_attempted",
            "unknown"
          ]
        },
        "name_resolution": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "not_attempted",
            "unknown"
          ]
        }
      },
      "required": [
        "port_scan",
        "service_detection",
        "os_detection",
        "name_resolution"
      ],
      "additionalProperties": false
    },
    "scan_issues": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "discovery",
              "port_scan",
              "service_detection",
              "os_detection",
              "name_resolution",
              "routing",
              "scanner"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "host_timeout",
              "permission_denied",
              "tool_unavailable",
              "resolution_timeout",
              "parse_error",
              "route_ambiguous",
              "execution_error",
              "other"
            ]
          }
        },
        "required": [
          "stage",
          "code"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "asset_id",
    "agent_id",
    "ip",
    "mac",
    "vendor",
    "hostname",
    "os",
    "services",
    "scan_time",
    "os_candidates",
    "state_reason",
    "host_scripts",
    "names",
    "mac_metadata",
    "asset_coverage",
    "scan_issues"
  ],
  "additionalProperties": false
}
