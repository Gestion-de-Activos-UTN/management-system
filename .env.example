# Requeridas
DATABASE_URL=postgresql://payload:payload@postgres:5432/payloadcms
PAYLOAD_SECRET=<random 32-char key>
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Auth0
AUTH0_SECRET=
AUTH0_BASE_URL=
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Storage (local)
LOCAL_STORAGE_PATH=/tmp/uploads

# RBAC
RBAC_SOURCE=db   # 'static' | 'db'

# Audit log
AUDIT_LOG_ENCRYPTION_KEY=<64-char hex / 32-byte key>

# Seeding opcional
SEED_ON_START=if-empty
SEED_BASELINE_ON_START=1
