# Requeridas
DATABASE_URL=postgresql://payload:payload@postgres:5432/payloadcms
PAYLOAD_SECRET=<random 32-char key>
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Auth0
AUTH0_SECRET=
AUTH0_BASE_URL=
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# RBAC
RBAC_SOURCE=db   # 'static' | 'db'

# AuditLog: dos llaveros versionados (HMAC de la cadena y AES-256-GCM del contexto de red).
# En desarrollo, generarlos con `pnpm audit:keys:init`: los agrega a .env.local con permisos
# 600, solo si faltan, sin pisar nada ni imprimir claves. Por eso acá van comentados.
# Formato: lista `id:base64` separada por comas, sin espacios ni comillas. id en minúsculas,
# dígitos y guiones (3 a 64); en desarrollo con prefijo dev-. Clave: 32 bytes en base64
# estándar, una por versión (a mano: `openssl rand -base64 32`). Los dos llaveros no pueden
# compartir claves. En producción no se admite ningún id dev-.
# AUDIT_HMAC_KEYS=dev-AAAAMMDD-xxxx:<base64 de 32 bytes>
# AUDIT_HMAC_ACTIVE_KEY_ID=dev-AAAAMMDD-xxxx
# AUDIT_NETWORK_KEYS=dev-AAAAMMDD-yyyy:<otra clave de 32 bytes en base64>
# AUDIT_NETWORK_ACTIVE_KEY_ID=dev-AAAAMMDD-yyyy

# Seeding opcional
SEED_ON_START=if-empty
SEED_BASELINE_ON_START=1

# Recuperación al arrancar: solo con un único proceso worker.
# Usar 0 si varios procesos comparten las colas; requieren recuperación con leases.
SIAM_JOB_RECOVERY_ON_START=1

